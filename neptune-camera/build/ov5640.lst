1695:Core/Src/ov5640.c ****           }
1696:Core/Src/ov5640.c ****           else
1697:Core/Src/ov5640.c ****           {
1698:Core/Src/ov5640.c ****             if (ov5640_write_reg(&pObj->Ctx, OV5640_TIMING_TC_REG21, &tmp3821, 1) != OV5640_OK)
1699:Core/Src/ov5640.c ****             {
1700:Core/Src/ov5640.c ****               ret = OV5640_ERROR;
1701:Core/Src/ov5640.c ****             }
1702:Core/Src/ov5640.c ****           }
1703:Core/Src/ov5640.c ****           break;
1704:Core/Src/ov5640.c ****       }
1705:Core/Src/ov5640.c ****     }
