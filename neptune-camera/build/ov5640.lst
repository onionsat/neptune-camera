1874:Core/Src/ov5640.c **** /**
1875:Core/Src/ov5640.c ****   * @brief  Configure Embedded Synchronization mode.
1876:Core/Src/ov5640.c ****   * @param  pObj  pointer to component object
1877:Core/Src/ov5640.c ****   * @param  pSyncCodes  pointer to Embedded Codes
1878:Core/Src/ov5640.c ****   * @retval Component status
1879:Core/Src/ov5640.c ****   */
1880:Core/Src/ov5640.c **** 
1881:Core/Src/ov5640.c **** int32_t OV5640_EmbeddedSynchroConfig(OV5640_Object_t *pObj, OV5640_SyncCodes_t *pSyncCodes)
1882:Core/Src/ov5640.c **** {
1883:Core/Src/ov5640.c ****   uint8_t tmp;
1884:Core/Src/ov5640.c ****   int32_t ret = OV5640_ERROR;
1885:Core/Src/ov5640.c **** 
1886:Core/Src/ov5640.c ****   /*[7] : SYNC code from reg 0x4732-0x4732, [1]: Enable Clip ,[0]: Enable CCIR656 */
1887:Core/Src/ov5640.c ****   tmp = 0x83;
