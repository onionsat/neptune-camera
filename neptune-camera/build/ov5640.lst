1630:Core/Src/ov5640.c ****   }
1631:Core/Src/ov5640.c ****   else
1632:Core/Src/ov5640.c ****   {
1633:Core/Src/ov5640.c ****     tmp3820 &= 0xF9U;
1634:Core/Src/ov5640.c **** 
1635:Core/Src/ov5640.c ****     if (ov5640_read_reg(&pObj->Ctx, OV5640_TIMING_TC_REG21, &tmp3821, 1) != OV5640_OK)
1636:Core/Src/ov5640.c ****     {
1637:Core/Src/ov5640.c ****       ret = OV5640_ERROR;
1638:Core/Src/ov5640.c ****     }
1639:Core/Src/ov5640.c ****     else
1640:Core/Src/ov5640.c ****     {
1641:Core/Src/ov5640.c ****       ret = OV5640_OK;
1642:Core/Src/ov5640.c ****       tmp3821 &= 0xF9U;
1643:Core/Src/ov5640.c **** 
1644:Core/Src/ov5640.c ****       switch (Config)
1645:Core/Src/ov5640.c ****       {
1646:Core/Src/ov5640.c ****         case OV5640_MIRROR:
1647:Core/Src/ov5640.c ****           if (ov5640_write_reg(&pObj->Ctx, OV5640_TIMING_TC_REG20, &tmp3820, 1) != OV5640_OK)
1648:Core/Src/ov5640.c ****           {
1649:Core/Src/ov5640.c ****             ret = OV5640_ERROR;
1650:Core/Src/ov5640.c ****           }
1651:Core/Src/ov5640.c ****           else
1652:Core/Src/ov5640.c ****           {
1653:Core/Src/ov5640.c ****             tmp3821 |= 0x06U;
1654:Core/Src/ov5640.c ****             if (ov5640_write_reg(&pObj->Ctx, OV5640_TIMING_TC_REG21, &tmp3821, 1) != OV5640_OK)
1655:Core/Src/ov5640.c ****             {
1656:Core/Src/ov5640.c ****               ret = OV5640_ERROR;
1657:Core/Src/ov5640.c ****             }
1658:Core/Src/ov5640.c ****           }
1659:Core/Src/ov5640.c ****           break;
1660:Core/Src/ov5640.c ****         case OV5640_FLIP:
1661:Core/Src/ov5640.c ****           tmp3820 |= 0x06U;
1662:Core/Src/ov5640.c ****           if (ov5640_write_reg(&pObj->Ctx, OV5640_TIMING_TC_REG20, &tmp3820, 1) != OV5640_OK)
1663:Core/Src/ov5640.c ****           {
1664:Core/Src/ov5640.c ****             ret = OV5640_ERROR;
1665:Core/Src/ov5640.c ****           }
1666:Core/Src/ov5640.c ****           else
1667:Core/Src/ov5640.c ****           {
1668:Core/Src/ov5640.c ****             if (ov5640_write_reg(&pObj->Ctx, OV5640_TIMING_TC_REG21, &tmp3821, 1) != OV5640_OK)
1669:Core/Src/ov5640.c ****             {
ARM GAS  /tmp/ccy24VEl.s 			page 33


1670:Core/Src/ov5640.c ****               ret = OV5640_ERROR;
1671:Core/Src/ov5640.c ****             }
1672:Core/Src/ov5640.c ****           }
1673:Core/Src/ov5640.c ****           break;
1674:Core/Src/ov5640.c ****         case OV5640_MIRROR_FLIP:
1675:Core/Src/ov5640.c ****           tmp3820 |= 0x06U;
1676:Core/Src/ov5640.c ****           if (ov5640_write_reg(&pObj->Ctx, OV5640_TIMING_TC_REG20, &tmp3820, 1) != OV5640_OK)
1677:Core/Src/ov5640.c ****           {
1678:Core/Src/ov5640.c ****             ret = OV5640_ERROR;
1679:Core/Src/ov5640.c ****           }
1680:Core/Src/ov5640.c ****           else
1681:Core/Src/ov5640.c ****           {
1682:Core/Src/ov5640.c ****             tmp3821 |= 0x06U;
1683:Core/Src/ov5640.c ****             if (ov5640_write_reg(&pObj->Ctx, OV5640_TIMING_TC_REG21, &tmp3821, 1) != OV5640_OK)
1684:Core/Src/ov5640.c ****             {
1685:Core/Src/ov5640.c ****               ret = OV5640_ERROR;
1686:Core/Src/ov5640.c ****             }
1687:Core/Src/ov5640.c ****           }
1688:Core/Src/ov5640.c ****           break;
1689:Core/Src/ov5640.c **** 
1690:Core/Src/ov5640.c ****         case OV5640_MIRROR_FLIP_NONE:
1691:Core/Src/ov5640.c ****         default:
1692:Core/Src/ov5640.c ****           if (ov5640_write_reg(&pObj->Ctx, OV5640_TIMING_TC_REG20, &tmp3820, 1) != OV5640_OK)
