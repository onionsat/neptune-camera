1005:Core/Src/ov5640.c ****   uint8_t tmp;
1006:Core/Src/ov5640.c **** 
1007:Core/Src/ov5640.c ****   /* Initialize I2C */
1008:Core/Src/ov5640.c ****   pObj->IO.Init();
1009:Core/Src/ov5640.c **** 
