 940:Core/Src/ov5640.c ****                              uint32_t VsyncPolarity)
 941:Core/Src/ov5640.c **** {
 942:Core/Src/ov5640.c ****   uint8_t tmp;
 943:Core/Src/ov5640.c ****   int32_t ret = OV5640_OK;
 944:Core/Src/ov5640.c **** 
