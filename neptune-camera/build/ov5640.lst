1615:Core/Src/ov5640.c **** /**
1616:Core/Src/ov5640.c ****   * @brief  Control OV5640 camera mirror/vflip.
1617:Core/Src/ov5640.c ****   * @param  pObj  pointer to component object
1618:Core/Src/ov5640.c ****   * @param  Config To configure mirror, flip, both or none
1619:Core/Src/ov5640.c ****   * @retval Component status
1620:Core/Src/ov5640.c ****   */
1621:Core/Src/ov5640.c **** int32_t OV5640_MirrorFlipConfig(OV5640_Object_t *pObj, uint32_t Config)
1622:Core/Src/ov5640.c **** {
1623:Core/Src/ov5640.c ****   int32_t ret;
1624:Core/Src/ov5640.c ****   uint8_t tmp3820 = 0;
1625:Core/Src/ov5640.c ****   uint8_t tmp3821;
1626:Core/Src/ov5640.c **** 
