  87:Core/Src/ov5640.c ****   * @brief  Register component IO bus
ARM GAS  /tmp/ccy24VEl.s 			page 3


  88:Core/Src/ov5640.c ****   * @param  Component object pointer
  89:Core/Src/ov5640.c ****   * @retval Component status
  90:Core/Src/ov5640.c ****   */
  91:Core/Src/ov5640.c **** int32_t OV5640_RegisterBusIO(OV5640_Object_t *pObj, OV5640_IO_t *pIO)
  92:Core/Src/ov5640.c **** {
  93:Core/Src/ov5640.c ****   int32_t ret;
  94:Core/Src/ov5640.c **** 
  95:Core/Src/ov5640.c ****   if (pObj == NULL)
  96:Core/Src/ov5640.c ****   {
  97:Core/Src/ov5640.c ****     ret = OV5640_ERROR;
  98:Core/Src/ov5640.c ****   }
  99:Core/Src/ov5640.c ****   else
 100:Core/Src/ov5640.c ****   {
 101:Core/Src/ov5640.c ****     pObj->IO.Init      = pIO->Init;
 102:Core/Src/ov5640.c ****     pObj->IO.DeInit    = pIO->DeInit;
 103:Core/Src/ov5640.c ****     pObj->IO.Address   = pIO->Address;
 104:Core/Src/ov5640.c ****     pObj->IO.WriteReg  = pIO->WriteReg;
 105:Core/Src/ov5640.c ****     pObj->IO.ReadReg   = pIO->ReadReg;
 106:Core/Src/ov5640.c ****     pObj->IO.GetTick   = pIO->GetTick;
 107:Core/Src/ov5640.c **** 
 108:Core/Src/ov5640.c ****     pObj->Ctx.ReadReg  = OV5640_ReadRegWrap;
 109:Core/Src/ov5640.c ****     pObj->Ctx.WriteReg = OV5640_WriteRegWrap;
 110:Core/Src/ov5640.c ****     pObj->Ctx.handle   = pObj;
 111:Core/Src/ov5640.c **** 
 112:Core/Src/ov5640.c ****     if (pObj->IO.Init != NULL)
 113:Core/Src/ov5640.c ****     {
 114:Core/Src/ov5640.c ****       ret = pObj->IO.Init();
 115:Core/Src/ov5640.c ****     }
 116:Core/Src/ov5640.c ****     else
 117:Core/Src/ov5640.c ****     {
 118:Core/Src/ov5640.c ****       ret = OV5640_ERROR;
 119:Core/Src/ov5640.c ****     }
 120:Core/Src/ov5640.c ****   }
 121:Core/Src/ov5640.c **** 
 122:Core/Src/ov5640.c ****   return ret;
 123:Core/Src/ov5640.c **** }
