1013:Core/Src/ov5640.c ****   {
1014:Core/Src/ov5640.c ****     ret = OV5640_ERROR;
1015:Core/Src/ov5640.c ****   }
1016:Core/Src/ov5640.c ****   else
1017:Core/Src/ov5640.c ****   {
1018:Core/Src/ov5640.c ****     (void)OV5640_Delay(pObj, 500);
1019:Core/Src/ov5640.c **** 
1020:Core/Src/ov5640.c ****     if (ov5640_read_reg(&pObj->Ctx, OV5640_CHIP_ID_HIGH_BYTE, &tmp, 1) != OV5640_OK)
1021:Core/Src/ov5640.c ****     {
1022:Core/Src/ov5640.c ****       ret = OV5640_ERROR;
1023:Core/Src/ov5640.c ****     }
1024:Core/Src/ov5640.c ****     else
1025:Core/Src/ov5640.c ****     {
1026:Core/Src/ov5640.c ****       *Id = (uint32_t)tmp << 8U;
1027:Core/Src/ov5640.c ****       if (ov5640_read_reg(&pObj->Ctx, OV5640_CHIP_ID_LOW_BYTE, &tmp, 1) != OV5640_OK)
1028:Core/Src/ov5640.c ****       {
1029:Core/Src/ov5640.c ****         ret = OV5640_ERROR;
1030:Core/Src/ov5640.c ****       }
1031:Core/Src/ov5640.c ****       else
1032:Core/Src/ov5640.c ****       {
1033:Core/Src/ov5640.c ****         *Id |= tmp;
1034:Core/Src/ov5640.c ****         ret = OV5640_OK;
1035:Core/Src/ov5640.c ****       }
1036:Core/Src/ov5640.c ****     }
1037:Core/Src/ov5640.c ****   }
1038:Core/Src/ov5640.c **** 
1039:Core/Src/ov5640.c ****   /* Component status */
1040:Core/Src/ov5640.c ****   return ret;
1041:Core/Src/ov5640.c **** }
