 971:Core/Src/ov5640.c ****   */
 972:Core/Src/ov5640.c **** int32_t OV5640_GetPolarities(OV5640_Object_t *pObj, uint32_t *PclkPolarity, uint32_t *HrefPolarity,
 973:Core/Src/ov5640.c ****                              uint32_t *VsyncPolarity)
 974:Core/Src/ov5640.c **** {
 975:Core/Src/ov5640.c ****   uint8_t tmp;
 976:Core/Src/ov5640.c ****   int32_t ret = OV5640_OK;
 977:Core/Src/ov5640.c **** 
 978:Core/Src/ov5640.c ****   if ((pObj == NULL) || (PclkPolarity == NULL) || (HrefPolarity == NULL) || (VsyncPolarity == NULL)
 979:Core/Src/ov5640.c ****   {
 980:Core/Src/ov5640.c ****     ret = OV5640_ERROR;
 981:Core/Src/ov5640.c ****   }
 982:Core/Src/ov5640.c ****   else if (ov5640_read_reg(&pObj->Ctx, OV5640_POLARITY_CTRL, &tmp, 1) != OV5640_OK)
