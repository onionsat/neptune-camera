1891:Core/Src/ov5640.c ****     if (ov5640_write_reg(&pObj->Ctx, OV5640_CCIR656_FS, &tmp, 1) == OV5640_OK)
1892:Core/Src/ov5640.c ****     {
1893:Core/Src/ov5640.c ****       tmp = pSyncCodes->FrameEndCode;
1894:Core/Src/ov5640.c ****       if (ov5640_write_reg(&pObj->Ctx, OV5640_CCIR656_FE, &tmp, 1) != OV5640_OK)
1895:Core/Src/ov5640.c ****       {
1896:Core/Src/ov5640.c ****         return OV5640_ERROR;
1897:Core/Src/ov5640.c ****       }
ARM GAS  /tmp/ccy24VEl.s 			page 37


1898:Core/Src/ov5640.c ****       tmp = pSyncCodes->LineStartCode;
1899:Core/Src/ov5640.c ****       if (ov5640_write_reg(&pObj->Ctx, OV5640_CCIR656_LS, &tmp, 1) == OV5640_OK)
1900:Core/Src/ov5640.c ****       {
1901:Core/Src/ov5640.c ****         tmp = pSyncCodes->LineEndCode;
1902:Core/Src/ov5640.c ****         if (ov5640_write_reg(&pObj->Ctx, OV5640_CCIR656_LE, &tmp, 1) == OV5640_OK)
1903:Core/Src/ov5640.c ****         {
1904:Core/Src/ov5640.c ****           /*Adding 1 dummy line */
1905:Core/Src/ov5640.c ****           tmp = 0x01;
1906:Core/Src/ov5640.c ****           if (ov5640_write_reg(&pObj->Ctx, OV5640_656_DUMMY_LINE, &tmp, 1) == OV5640_OK)
1907:Core/Src/ov5640.c ****           {
1908:Core/Src/ov5640.c ****             ret = OV5640_OK;
1909:Core/Src/ov5640.c ****           }
1910:Core/Src/ov5640.c ****         }
1911:Core/Src/ov5640.c ****       }
1912:Core/Src/ov5640.c ****     }
1913:Core/Src/ov5640.c ****   }
1914:Core/Src/ov5640.c **** 
1915:Core/Src/ov5640.c ****   /* max clip value[9:8], to avoid SYNC code clipping */
1916:Core/Src/ov5640.c ****   tmp = 0x2;
1917:Core/Src/ov5640.c ****   if (ret == OV5640_OK)
1918:Core/Src/ov5640.c ****   {
1919:Core/Src/ov5640.c ****     ret = ov5640_write_reg(&pObj->Ctx, 0x4302, &tmp, 1);
1920:Core/Src/ov5640.c ****   }
1921:Core/Src/ov5640.c ****   if (ret == OV5640_OK)
1922:Core/Src/ov5640.c ****   {
1923:Core/Src/ov5640.c ****     ret = ov5640_write_reg(&pObj->Ctx, 0x4306, &tmp, 1);
1924:Core/Src/ov5640.c ****   }
1925:Core/Src/ov5640.c ****   if (ret == OV5640_OK)
1926:Core/Src/ov5640.c ****   {
1927:Core/Src/ov5640.c ****     ret = ov5640_write_reg(&pObj->Ctx, 0x430A, &tmp, 1);
1928:Core/Src/ov5640.c ****   }
1929:Core/Src/ov5640.c **** 
1930:Core/Src/ov5640.c ****   return ret;
1931:Core/Src/ov5640.c **** }
