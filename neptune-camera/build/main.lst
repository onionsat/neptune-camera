 174:Core/Src/main.c **** void sendPicture()
 175:Core/Src/main.c **** {
 176:Core/Src/main.c ****   for(int i = 0; i < FRAME_BUFFER_WORDS; i++)
 177:Core/Src/main.c ****   {
 178:Core/Src/main.c ****     snprintfWritten = snprintf(UARTbuffer, sizeof(UARTbuffer), "%lu\n", frameBuffer[i]);
 179:Core/Src/main.c ****     HAL_UART_Transmit(&huart2, (uint8_t*)UARTbuffer, snprintfWritten, HAL_MAX_DELAY);
 180:Core/Src/main.c ****   }
 181:Core/Src/main.c **** }
